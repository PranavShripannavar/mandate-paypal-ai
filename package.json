{
  "name": "mandate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/policy.test.ts tests/session.test.ts",
    "test:integration": "tsx scripts/integration.ts",
    "test:postgres": "tsx scripts/local-postgres.ts",
    "callback": "tsx src/callback.ts",
    "build": "next build --webpack",
    "lint": "eslint src tests scripts app",
    "db:migrate": "tsx scripts/migrate.ts",
    "dev": "tsx scripts/dev.ts",
    "build:backend": "tsc -p tsconfig.build.json",
    "start": "next start"
  },
  "dependencies": {
    "@google/genai": "^2.31.0",
    "next": "^16.4.3",
    "pg": "8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "10.13.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
